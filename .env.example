# Copy to .env and fill in. Never commit real secrets.
VITE_FORM_ENDPOINT=
# Example: VITE_FORM_ENDPOINT=https://api.techvya.com/contact
# Or a Formspree/Form-Data endpoint. Must accept JSON POST.
# Optional when Supabase below is configured (Supabase takes priority).

# Supabase (powers the contact form). Get both from Supabase dashboard:
# Project Settings (gear icon) -> API -> Project URL + anon public key.
# NEVER use the service_role key in the website.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
